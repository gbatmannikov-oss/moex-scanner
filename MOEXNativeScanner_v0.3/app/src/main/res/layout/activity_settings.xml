<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="18dp" android:background="#101114" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="Algopack" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="Токен хранится только на этом телефоне. Не отправляйте его в чат." android:textColor="#B0BEC5" android:paddingTop="8dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/token" android:hint="Bearer token" android:inputType="textPassword" android:textColor="#FFFFFF" android:textColorHint="#78909C" android:backgroundTint="#546E7A" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/save" android:text="Сохранить" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/test" android:text="Проверить Algopack" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/result" android:textColor="#CFD8DC" android:paddingTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
